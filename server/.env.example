# Copy this file to .env and replace <YOUR_PASSWORD> with your DB password.
# Example DATABASE_URL for Supabase pooler (replace <YOUR_PASSWORD>):
DATABASE_URL=postgresql://postgres.glvjywfxzzdkyicddlez:<YOUR_PASSWORD>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Alternatively set components:
PGHOST=aws-1-us-west-2.pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.glvjywfxzzdkyicddlez
PGPASSWORD=<YOUR_PASSWORD>

# Optionally set a single connection variable used by index.js
# PG_CONNECTION=postgresql://user:pass@host:port/db

# NODE_ENV=development
# PORT=3000
